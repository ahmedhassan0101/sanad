# Copy to .env for local dev. Never commit .env.
MONGODB_URI_DEV=mongodb://127.0.0.1:27017/halaqa_dev?replicaSet=rs0
MONGODB_URI_PROD=
INVITE_CODE_PEPPER=change-me-in-production-min-32-chars
AUTH_SECRET=dev-secret-change-me-in-production
AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOW_DEV_SEED=false
EMAIL_ENABLED=false
# Required when EMAIL_ENABLED=true. Without a verified domain, Resend only
# delivers to your own Resend account email (test sender below).
RESEND_FROM=onboarding@resend.dev
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
